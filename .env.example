# HOPe Sponsor Assistant — Environment Variables
# Copy this file to .env.local and fill in values only for the features you want to turn on.
# You can add the API keys later.

# OpenAI (required only for AI draft generation, AI chat, and AI file matching)
OPENAI_API_KEY=sk-...

# Resend (required only for email sending and scheduled email delivery)
RESEND_API_KEY=re_...
RESEND_SENDER_EMAIL=noreply@yourdomain.com

# Twilio (required only for WhatsApp sending and scheduled WhatsApp delivery)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_FROM=+14155238886

# Database (for local development, leave DB_PATH as default)
DB_PATH=./data/sponsor_assistant.db

# App
NEXT_PUBLIC_APP_NAME=HOPe
