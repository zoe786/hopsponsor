# HOPe Sponsor Assistant — Environment Variables
# Copy this file to .env.local and fill in your values

# OpenAI
OPENAI_API_KEY=sk-...

# Resend (email sending)
RESEND_API_KEY=re_...
RESEND_SENDER_EMAIL=noreply@yourdomain.com

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_FROM=+14155238886

# Database (for local development, leave DB_PATH as default)
# For production Vercel deployment, use Turso:
#   TURSO_DATABASE_URL=libsql://your-db.turso.io
#   TURSO_AUTH_TOKEN=...
DB_PATH=./data/sponsor_assistant.db

# App
NEXT_PUBLIC_APP_NAME=HOPe
